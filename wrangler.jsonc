{
  // Cloudflare Workers static-assets deploy for graylayer.io.
  // Cloudflare's build runs `npm run build`, then `npx wrangler deploy`.
  "name": "graylayer-io",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
