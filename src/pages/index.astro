---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostRow from '@/components/PostRow.astro';
import { getCv, getPosts, getProjects } from '@/lib/site';

const cv = await getCv();
const featured = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout title="Home">
  <div class="wrap page">
    <section class="hero">
      <p class="eyebrow">{cv.name} · ML engineer · Dublin</p>
      <h1 class="h1 big">I build reinforcement learning systems and write up what I learn.</h1>
      <p class="lede">
        Evaluation, training infrastructure and production ML. Each project has its write-ups, demos and code in one place.
      </p>
      <div class="cta">
        <a href="/projects/" class="btn btn-primary">See projects</a>
        <a href="/about/" class="btn">About me / CV</a>
      </div>
    </section>

    <section class="block">
      <div class="head">
        <h2 class="h2">Featured projects</h2>
        <a href="/projects/" class="more">All projects →</a>
      </div>
      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    <section class="block">
      <div class="head">
        <h2 class="h2">Latest writing</h2>
        <a href="/writing/" class="more">All posts →</a>
      </div>
      <div>
        {posts.map((p) => <PostRow post={p} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 96px;
  }
  .hero {
    max-width: 760px;
  }
  .big {
    margin-top: 20px;
    font-size: clamp(36px, 8vw, 60px);
    line-height: 1.04;
  }
  .lede {
    margin-top: 24px;
    font-size: 19px;
  }
  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    margin-top: 96px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }
  .more {
    font-size: 14px;
    color: var(--muted);
  }
  .more:hover {
    color: var(--fg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
</style>
