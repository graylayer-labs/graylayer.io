---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostRow from '@/components/PostRow.astro';
import { getAbout, getPosts, getProjects } from '@/lib/site';

const { data: about } = await getAbout();
const featured = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout title="Home">
  <div class="wrap page">
    <section class="hero">
      <p class="who">{about.name}, {about.title.toLowerCase()} in Dublin</p>
      <h1 class="big">I build ML systems.</h1>
      <p class="sub">From choosing the model to running it in production.</p>
      <div class="cta">
        <a href="/projects/" class="btn btn-primary">See projects</a>
        <a href="/about/" class="btn">About me</a>
      </div>
    </section>

    <section class="block featured">
      <div class="head">
        <h2 class="h2">Featured projects</h2>
        <a href="/projects/" class="more">All projects</a>
      </div>
      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    {posts.length > 0 && <section class="block">
      <div class="head latest">
        <h2 class="h2">Latest writing</h2>
        <a href="/writing/" class="more">All posts</a>
      </div>
      <div>
        {posts.map((p) => <PostRow post={p} />)}
      </div>
    </section>}
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 64px;
  }
  @media (max-width: 600px) {
    .page {
      padding-top: 48px;
    }
  }
  .who {
    font-size: 15px;
    color: var(--muted);
  }
  /* The one loud element on the page: a single line at display size. */
  .big {
    margin-top: 16px;
    font-size: clamp(44px, 8.5vw, 96px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .sub {
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted);
  }
  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    margin-top: 96px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }
  .featured {
    margin-top: 72px;
  }
  .latest {
    margin-bottom: 8px;
  }
  .more {
    font-size: 14px;
    color: var(--muted);
  }
  .more:hover {
    color: var(--fg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
</style>
