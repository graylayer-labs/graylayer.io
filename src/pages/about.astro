---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCv, getProjects, projectHref } from '@/lib/site';

const cv = await getCv();
const featured = (await getProjects()).filter((p) => p.data.featured);
---

<BaseLayout title="About" description={`${cv.name}: ${cv.headline}`}>
  <div class="wrap page layout">
    <aside>
      <div class="photo mono">[PHOTO]</div>
      <div>
        <h1 class="name">{cv.name}</h1>
        <p class="hl">{cv.headline}</p>
        <p class="loc mono">{cv.location}</p>
      </div>
      <div class="links">
        {cv.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}
      </div>
      <a href={cv.cv_pdf} class="btn btn-primary dl">Download CV (PDF)</a>
      <p class="open"><span class="ok">●</span> Open to: {cv.open_to}</p>
    </aside>

    <div class="col">
      <p class="intro">{cv.intro}</p>

      <section>
        <h2 class="section-label sh">Experience</h2>
        {cv.experience.map((e) => (
          <div class="job">
            <span class="per mono">{e.period}</span>
            <div class="jb">
              <span class="role">{e.role} <span class="emp">· {e.employer}</span></span>
              {e.highlights.length > 0 && <ul>{e.highlights.map((h) => <li>{h}</li>)}</ul>}
            </div>
          </div>
        ))}
      </section>

      <section>
        <h2 class="section-label sh">Selected projects</h2>
        <div class="proj">
          {featured.map((p) => (
            <a href={projectHref(p)} class="pc" style={`--accent:${p.data.accent}`}>
              <span class="pn">{p.data.title}</span>
              <span class="ps">{p.data.summary}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="two">
        <div>
          <h2 class="section-label sh">Education</h2>
          {cv.education.map((e) => (
            <>
              <p class="deg">{e.degree}</p>
              <p class="inst">{e.institution} · {e.year}</p>
            </>
          ))}
        </div>
        <div>
          <h2 class="section-label sh">Skills</h2>
          <div class="skills">{cv.skills.map((s) => <span>{s}</span>)}</div>
        </div>
      </section>

      <section>
        <h2 class="section-label sh">Publications and talks</h2>
        {cv.publications.map((p) => (
          <p class="pub">{p.citation} {p.url && <a href={p.url}>PDF</a>}</p>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }
  aside {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .photo {
    width: 112px;
    height: 112px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--faint);
  }
  .name {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .hl {
    margin-top: 8px;
    color: var(--muted);
  }
  .loc {
    margin-top: 8px;
    font-size: 13px;
    color: var(--faint);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }
  .links a {
    padding: 6px 0;
    color: var(--muted);
  }
  .links a:hover {
    color: var(--fg);
  }
  .dl {
    align-self: flex-start;
  }
  .open {
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .ok {
    color: var(--ok);
  }
  .col {
    flex: 999 1 min(560px, 100%);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .intro {
    font-size: 19px;
    line-height: 1.65;
    color: var(--fg-2);
  }
  .sh {
    margin-bottom: 16px;
  }
  .job {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }
  .per {
    font-size: 13px;
    color: var(--faint);
    padding-top: 3px;
  }
  .jb {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .role {
    font-size: 17px;
    font-weight: 600;
  }
  .emp {
    font-weight: 400;
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding-left: 18px;
    color: var(--fg-3);
    font-size: 15px;
    line-height: 1.6;
  }
  .proj {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 12px;
  }
  .pc {
    padding: 16px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pn {
    font-weight: 600;
  }
  .ps {
    font-size: 14px;
    color: var(--muted);
  }
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 48px;
  }
  .deg {
    font-size: 16px;
    font-weight: 600;
  }
  .inst {
    margin-top: 4px;
    font-size: 15px;
    color: var(--muted);
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
  }
  .skills span {
    padding: 5px 10px;
    background: var(--surface-2);
    border-radius: 6px;
  }
  .pub {
    font-size: 15px;
    color: var(--fg-3);
    line-height: 1.6;
  }
  .pub a {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
