---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getAbout } from '@/lib/site';

const entry = await getAbout();
const { data } = entry;
const { Content } = await render(entry);
---

<BaseLayout
  title="About"
  description={`${data.name}, ${data.title.toLowerCase()} in Dublin, focused on model design from choosing the right model to production.`}
>
  <div class="wrap page">
    <p class="eyebrow">{data.location}</p>
    <h1 class="h1 name">{data.name}</h1>
    <p class="lede role">{data.title}</p>

    <div class="prose bio"><Content /></div>

    <section class="block">
      <h2 class="section-label sh">What I work with</h2>
      {data.skills.map((g) => (
        <div class="sg">
          <p class="gl">{g.label}</p>
          <div class="skills">{g.items.map((i) => <span>{i}</span>)}</div>
        </div>
      ))}
    </section>

    <section class="block">
      <h2 class="section-label sh">Elsewhere</h2>
      <div class="links">
        {data.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 760px;
  }
  .name {
    margin-top: 12px;
  }
  .role {
    margin-top: 8px;
  }
  .bio {
    margin-top: 40px;
  }
  .block {
    margin-top: 48px;
  }
  .sh {
    margin-bottom: 16px;
  }
  .gl {
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 500;
  }
  .sg + .sg {
    margin-top: 16px;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
  }
  .skills span {
    padding: 5px 10px;
    background: var(--surface-2);
    border-radius: 6px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 15px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--fg);
  }
</style>
