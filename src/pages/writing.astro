---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FEED_URL, fmtDate, getPosts, postHref } from '@/lib/site';
import { getEntry } from 'astro:content';

const posts = await getPosts();
const rows = await Promise.all(
  posts.map(async (post) => ({ post, project: (await getEntry(post.data.project))! })),
);
const years = [...new Set(rows.map((r) => r.post.data.pubDate.getUTCFullYear()))];
---

<BaseLayout title="Writing" description="Every post, across all projects, newest first.">
  <div class="page narrow">
    <div class="top">
      <div>
        <h1 class="h1">Writing</h1>
        <p class="lede intro">Every post, across all projects, newest first.</p>
      </div>
      {FEED_URL && <a href={FEED_URL} class="btn">RSS feed</a>}
    </div>

    {rows.length === 0 && <p class="lede intro">No posts yet.</p>}
    {years.map((year, i) => (
      <>
        <h2 class="section-label yr" style={i === 0 ? 'margin-top:56px' : 'margin-top:48px'}>{year}</h2>
        {rows.filter((r) => r.post.data.pubDate.getUTCFullYear() === year).map(({ post, project }) => (
          <a href={postHref(post)} class="row list-row" style={`--accent:${project.data.accent}`}>
            <span class="date">{fmtDate(post.data.pubDate, { day: '2-digit', month: 'short' })}</span>
            <span class="rb">
              <span class="list-title ttl">{post.data.title}</span>
              <span class="pj"><span class="dot"></span>{project.data.title} · Part {post.data.part}</span>
            </span>
          </a>
        ))}
      </>
    ))}
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .intro {
    margin-top: 12px;
  }
  .row {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 20px;
    justify-content: stretch;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--faint);
    padding-top: 3px;
  }
  .rb {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ttl {
    font-size: 18px;
    font-weight: 600;
  }
  .pj {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
