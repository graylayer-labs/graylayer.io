---
import ThemeToggle from '@/components/ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand"><span class="mark"></span>graylayer</a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['link', { current: path.startsWith(l.href) }]}
          aria-current={path.startsWith(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    padding-block: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
  }
  .mark {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--fg);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
  }
  .link {
    padding: 10px 12px;
    color: var(--muted);
  }
  .link:hover,
  .link.current {
    color: var(--fg);
  }
  .link.current {
    font-weight: 500;
  }
</style>
