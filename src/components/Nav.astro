---
import ThemeToggle from '@/components/ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" /><path d="M0 8a8 8 0 0 1 8-8h16a8 8 0 0 1 8 8v10H0z" /></svg>graylayer</a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['link', { current: path.startsWith(l.href) }]}
          aria-current={path.startsWith(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    padding-block: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
  }
  .mark {
    width: 20px;
    height: 20px;
  }
  .mark rect {
    fill: var(--mark-base);
  }
  .mark path {
    fill: var(--fg);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
  }
  .link {
    padding: 10px 12px;
    color: var(--muted);
  }
  .link:hover,
  .link.current {
    color: var(--fg);
  }
  .link.current {
    font-weight: 500;
  }
  @media (max-width: 420px) {
    .bar {
      flex-wrap: nowrap;
      gap: 8px;
    }
    nav {
      gap: 0;
    }
    .link {
      padding-inline: 7px;
    }
  }
</style>
