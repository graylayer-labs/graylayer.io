---
import { FEED_URL, getAbout } from '@/lib/site';

const { data: about } = await getAbout();
const links = [...about.links.filter((l) => ['GitHub', 'LinkedIn'].includes(l.label))];
if (FEED_URL) links.push({ label: 'RSS', url: FEED_URL });
---

<footer>
  <div class="wrap bar">
    <span>© {about.name}</span>
    <span class="links">
      {links.map((l) => <a href={l.url}>{l.label}</a>)}
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
  }
  .bar {
    padding-block: 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
    color: var(--faint);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--fg);
  }
</style>
